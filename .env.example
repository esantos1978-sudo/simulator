# Clave de la API de Google AI Studio (Gemini). OBLIGATORIA.
# https://aistudio.google.com/app/apikey
# También se acepta el nombre GOOGLE_API_KEY.
GEMINI_API_KEY=

# Modelo de generación de imágenes. Opcional.
# Si se deja vacío se prueban en orden, hasta que uno responda:
#   gemini-nano-banana-2.1    (Nano Banana 2.1, recomendado)
#   gemini-3.1-flash-image    (Nano Banana 2, estable, hasta 4K)
#   gemini-2.5-flash-image    (Nano Banana, legacy)
# Al rellenarlo se usa SOLO ese modelo (útil para forzar gemini-3-pro-image).
GEMINI_IMAGE_MODEL=

# Contraseña del simulador. Opcional en desarrollo (la ruta está abierta en `next dev`).
# En producción es OBLIGATORIA: sin ella el endpoint responde 401.
MOCKUP_PASSWORD=

